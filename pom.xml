<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.arbitcds.client.xmpp</groupId>
  <artifactId>XMPPClientLDO</artifactId>
  <version>1.0.0-SNAPSHOT</version>

  <!-- Il risultato della compilazione viene confezionato in un file JAR. -->
  <packaging>jar</packaging>

  <!-- Nome descrittivo del progetto -->
  <name>XMPPClientLDO</name>

  <properties>
      <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
      <maven.compiler.release>21</maven.compiler.release>
      <smack.version>4.3.5</smack.version>
  </properties>

  <dependencies>
    <!-- Ho aggionato le versioni della libreria Smack a 4.3.5 -->
    <!-- 
      Smack is a library for client-to-server XMPP connections to perform real-time communications and data exchange. 
      This includes, but is not limited to, instant messaging and group chat. More genericly speaking, 
      it allows you to easily exchange data in various ways: For example fire-and-forget, publish-subscribe, between human and non-human endpoints.
      Smack doesn't force you to code at the protcol level of XMPP. The library provides intelligent higher level constructs, often called Manager, 
      which let you program more efficiently. Other examples of those constructs are the Chat and Roster classes.
      Smack comes with APIs for easy machine-to-machine communication. You can set any number of properties on each message, including properties that are Java objects.
    -->
    <dependency>
      <groupId>org.igniterealtime.smack</groupId> 
      <artifactId>smack-tcp</artifactId> <!-- questa è la libreria per eseguire connessioni XMPP tramite TCP -->
      <version>${smack.version}</version>
    </dependency>
    <dependency>
      <groupId>org.igniterealtime.smack</groupId>
      <artifactId>smack-extensions</artifactId> <!-- serve per la gestione degli account e delle chat di gruppo -->
      <version>${smack.version}</version>
    </dependency>
    <dependency>
      <groupId>org.igniterealtime.smack</groupId>
      <artifactId>smack-im</artifactId> <!-- fornisce le funzioni principali di instant messaging -->
      <version>${smack.version}</version>
    </dependency>
    <dependency>
      <groupId>org.igniterealtime.smack</groupId>
      <artifactId>smack-java7</artifactId> <!-- questo modulo fornisce implementazioni Smack basate sulle API introdotte a partire da Java 7 -->
      <version>${smack.version}</version>
    </dependency> 
   
  </dependencies>

  <build>

        <plugins>
            
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId> <!-- Questo plugin esegue la compilazione Java -->
                <version>3.13.0</version>
            </plugin>
            
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId> <!-- plugin che esegue i test durante la fase "test" di Maven -->
                <version>3.5.4</version>
            </plugin>
            
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId> <!-- plugin che crea un secondo JAR, quello con le dipendenze -->
                <version>3.3.0</version>
                
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <archive>
                        <manifest>
                            <mainClass>com.arbitcds.client.xmpp.XMPPMain</mainClass>
                        </manifest>
                    </archive>
                </configuration>

                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>

            </plugin>

        </plugins>

    </build>

</project>
